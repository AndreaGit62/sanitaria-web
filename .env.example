# Copiare in .env.local (escluso da Git) per lo sviluppo locale.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Dominio pubblico esatto dell'app. Locale: http://localhost:3000
NEXT_PUBLIC_SITE_URL=
AUTH_EMAIL_SIGNUP_ENABLED=false
# Web Push: only the VAPID public key may be exposed to the browser.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Server only. Paste a Supabase secret API key (or legacy service_role) here.
SUPABASE_SECRET_KEY=
PUSH_CRON_SECRET=
